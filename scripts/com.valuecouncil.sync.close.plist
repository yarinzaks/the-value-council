<?xml version="1.0" encoding="UTF-8"?>
<!--
  Pull GitHub-generated state down to the local Mac data directory,
  shortly AFTER the GHA market-close run finishes.

  Schedule: Mon-Fri 23:30 IL local. The GHA close run starts at
  23:00 IL (16:00 ET, market close) and is fast (~3 min — just
  mark-to-market on existing positions). 23:30 gives a safe cushion.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.valuecouncil.sync.close</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/yarinzaks/.local/bin/value-council-sync.sh</string>
    <string>close</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>/Users/yarinzaks</string>
  </dict>

  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>23</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>23</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>23</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>23</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>23</integer><key>Minute</key><integer>30</integer></dict>
  </array>

  <key>StandardOutPath</key>
  <string>/Users/yarinzaks/Library/Application Support/value-council/cron_logs/sync.close.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/yarinzaks/Library/Application Support/value-council/cron_logs/sync.close.err.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
