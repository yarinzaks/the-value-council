# =============================================================================
# The Value Council — Environment Configuration
# Copy this file to `.env` and fill in your real keys.
# Never commit `.env` — it is already in .gitignore.
# =============================================================================

# --- LLM ---------------------------------------------------------------------
# Google Gemini API key. Free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here

# --- Market data: fundamentals & screener ------------------------------------
# Financial Modeling Prep. Free tier: https://site.financialmodelingprep.com
FMP_API_KEY=your_fmp_key_here

# --- Market data: real-time quotes & news ------------------------------------
# Finnhub. Free tier: https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_key_here

# --- Market data: news with sentiment ----------------------------------------
# Alpha Vantage. Free tier: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here

# --- News aggregator ---------------------------------------------------------
# MarketAux. Free tier: https://www.marketaux.com
MARKETAUX_API_KEY=your_marketaux_key_here

# --- SEC EDGAR ---------------------------------------------------------------
# SEC requires a User-Agent header identifying you (name + email).
# See https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT=Your Name your@email.com

# --- TASE (optional, Israeli market) -----------------------------------------
# Register at https://openapi.tase.co.il for client credentials.
# Leave blank to disable Israeli stock data.
TASE_CLIENT_ID=
TASE_CLIENT_SECRET=

# --- Logging -----------------------------------------------------------------
# Standard levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
